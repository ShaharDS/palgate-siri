# Copy to functions/.env and fill in. These are NOT secrets.
# The real secrets (session token, phone) go to Secret Manager instead:
#   firebase functions:secrets:set PALGATE_SESSION_TOKEN
#   firebase functions:secrets:set PALGATE_PHONE

# Your gate's id (from `python tools/poc_palgate.py devices`).
PALGATE_DEVICE_ID=your-device-id

# 1 = primary, 2 = linked device (`python tools/poc_palgate.py check` tells you which).
PALGATE_TOKEN_TYPE=1

# Who may open the gate: one entry per person, SHA-256 hashes only (from tools/mint_secret.py).
# Used once, to seed the Firestore doc config/openGateSecrets on the first request.
# After that, add/revoke people in the Firebase console. No redeploy needed.
OPEN_GATE_SECRETS=[{"label":"alex","sha256":"<hash>","active":true},{"label":"sam","sha256":"<hash>","active":true}]
